pragma solidity 0.8.26;

import {Test, Vm} from "forge-std/Test.sol";
import {Squeeklings} from "../src/Squeeklings.sol";
import {SqueeklingsArt} from "../src/SqueeklingsArt.sol";
import {ISqueekCoreV3} from "../src/interfaces/ISqueekCoreV3.sol";
import {SqueekCoreReader as Reader} from "../src/libraries/SqueekCoreReader.sol";
import {ReaderHarness} from "./mocks/Harnesses.sol";
import {Loot, Kind, Rarity, Mood} from "../src/SqueekTypes.sol";

/// @notice Replays byte-exact eth_call replies captured from the pinned Sepolia SqueekCore V3
/// (0xfd6c166d4b8e2962e65746a13e5a0797cd4de0c4) at block 12,085,427 through a public RPC.
/// The deployed core encodes roundPage as ONE dynamic struct (a leading 0x20 offset word, then
/// certified, start, end, the rounds offset 0x100 and the record count), not as four bare values.
/// Nothing here is synthesised: every reply is stored exactly as the chain returned it.
contract CapturedSepoliaCore {
    mapping(bytes32 => bytes) internal replies;

    function set(bytes memory input, bytes memory output) external {
        replies[keccak256(input)] = output;
    }

    fallback(bytes calldata input) external returns (bytes memory) {
        bytes memory out = replies[keccak256(input)];
        require(out.length != 0, "no captured reply for this call");
        return out;
    }
}

contract LiveCoreLayoutTest is Test {
    uint64 constant GENESIS = 1_793_735_400; // configuration().genesisTimestamp
    uint64 constant DURATION = 600; // configuration().roundDuration
    uint64 constant LIVE_SETTLED = 567; // state().settledThroughRound at capture

    // state(): settledThroughRound 567, cumulativeWork 0x4879, cumulativeBlockUnits 0x1d180e7f6ef.
    bytes constant STATE =
        hex"";
    // configuration(): genesis 1793735400, duration 600, blockUnitsPerBlock 1e9.
    bytes constant CONFIG =
        hex"";
    // roundPage(558, 558, 0): 320 bytes, idle point read.
    bytes constant POINT_558 =
        hex"";
    // roundPage(564, 564, 0): 320 bytes.
    bytes constant POINT_564 =
        hex"";
    // roundPage(558, 564, 16): 320 bytes, certified 564, no active rounds (idle window).
    bytes constant PAGE_558_564 =
        hex"";
    // roundPage(194, 194, 0): point (work 6, units 0x20e2a469).
    bytes constant POINT_194 =
        hex"";
    // roundPage(230, 230, 0): point (work 0xee9, units 0x5550abbf6f).
    bytes constant POINT_230 =
        hex"";
    // roundPage(194, 230, 16): 2400 bytes, certified 230, 13 active records (195..205, 209, 210).
    bytes constant PAGE_194_230 =
        hex"";
    // roundPage(0, 564, 16): 2880 bytes, the largest reply a page read can produce (16 records).
    bytes constant PAGE_0_564_FULL =
        hex"";
    // roundPage(0, 564, 1): a truncated page certifies through 194, one before the next active round.
    bytes constant PAGE_0_564_ONE =
        hex"";

    CapturedSepoliaCore core;
    Squeeklings game;
    ReaderHarness reader;
    address alice = address(0xA11CE);
    address bob = address(0xB0B);

    event Returned(
        uint256 indexed tokenId,
        address indexed petOwner,
        uint8 itemId,
        Kind kind,
        Rarity rarity,
        uint64 work,
        uint96 blocks,
        uint64 busiest,
        bytes32 entropy,
        uint32 pity
    );

    function setUp() public {
        core = new CapturedSepoliaCore();
        core.set(abi.encodeCall(ISqueekCoreV3.state, ()), STATE);
        core.set(abi.encodeCall(ISqueekCoreV3.configuration, ()), CONFIG);
        _setPage(558, 558, 0, POINT_558);
        _setPage(564, 564, 0, POINT_564);
        _setPage(558, 564, 16, PAGE_558_564);
        _setPage(194, 194, 0, POINT_194);
        _setPage(230, 230, 0, POINT_230);
        _setPage(194, 230, 16, PAGE_194_230);
        _setPage(0, 564, 16, PAGE_0_564_FULL);
        _setPage(0, 564, 1, PAGE_0_564_ONE);
        vm.roll(12_085_427);
        reader = new ReaderHarness();
        game = new Squeeklings(address(core), address(new SqueeklingsArt()), address(0xD00D));
    }

    function _setPage(uint64 afterRound, uint64 throughRound, uint256 limit, bytes memory reply) internal {
        core.set(abi.encodeCall(ISqueekCoreV3.roundPage, (afterRound, throughRound, limit)), reply);
    }

    function _warpToRound(uint64 round) internal {
        vm.warp(uint256(GENESIS) + uint256(round - 1) * DURATION);
        assertEq(game.currentRound(), round);
    }

    /// @dev The compiler's own decoder agrees with the hand-checked layout the reader enforces.
    function testCapturedRepliesAreSingleStructEncoded() public pure {
        assertEq(POINT_564.length, 320, "point read is 320 bytes");
        assertEq(abi.decode(POINT_564, (uint256)), 32, "leading struct offset word");
        ISqueekCoreV3.RoundPage memory point = abi.decode(POINT_564, (ISqueekCoreV3.RoundPage));
        assertEq(point.certifiedThroughRound, 564);
        assertEq(point.start.cumulativeWork, 0x4879);
        assertEq(point.end.cumulativeBlockUnits, 0x1d180e7f6ef);
        assertEq(point.rounds.length, 0);

        assertEq(PAGE_0_564_FULL.length, 320 + 16 * 160, "sixteen records");
        ISqueekCoreV3.RoundPage memory full = abi.decode(PAGE_0_564_FULL, (ISqueekCoreV3.RoundPage));
        assertEq(full.rounds.length, 16);
        assertEq(full.certifiedThroughRound, 338);
        assertEq(full.rounds[15].roundId, 338);
        assertEq(full.rounds[0].roundId, 186);
    }

    /// @dev The reader accepts the live layout at every size a trip can produce, including the
    /// 2,880-byte maximum, and the truncated page certifies the gap before the next active round.
    function testReaderAcceptsLivePagesUpToTheMaximumSize() public view {
        (bool ok, Reader.Page memory p) = reader.page(address(core), 0, 564, 16);
        assertTrue(ok, "full page accepted");
        assertEq(p.rounds.length, 16);
        assertEq(p.certified, 338);
        assertEq(p.end.cumulativeWork, 0x11bc);

        (ok, p) = reader.page(address(core), 0, 564, 1);
        assertTrue(ok, "single-record page accepted");
        assertEq(p.rounds.length, 1);
        assertEq(p.certified, 194, "certified through the empty gap after round 186");
        assertEq(p.end.cumulativeWork, p.rounds[0].cumulativeWork);

        (ok, p) = reader.page(address(core), 558, 564, 16);
        assertTrue(ok, "idle page accepted");
        assertEq(p.rounds.length, 0);
        assertEq(p.certified, 564);
    }

    /// @dev An idle window: hatch, embark and return against the live bytes; the pet unlocks.
    function testIdleTripReturnsADreamCapsuleAgainstLiveBytes() public {
        _warpToRound(558);
        vm.prank(alice);
        uint256 id = game.hatch();
        vm.prank(alice);
        game.embark(id, 0);
        assertEq(game.expedition(id).startRound, 559);
        assertEq(game.expedition(id).endRound, 564);
        assertLe(game.expedition(id).endRound, LIVE_SETTLED);

        (bool ok, Reader.History memory h) = reader.history(address(core), 558, 564);
        assertTrue(ok);
        assertEq(h.work, 0);
        assertEq(h.blocks, 0);
        assertEq(h.busiest, 0);
        assertEq(h.entropy, keccak256(""));

        Loot memory result = game.returnHome(id);
        assertEq(uint8(result.kind), uint8(Kind.Dream));
        assertFalse(game.expedition(id).away);
        assertEq(game.itemBalanceOf(id, result.itemId), 1);

        vm.prank(alice);
        game.transferFrom(alice, bob, id);
        assertEq(game.ownerOf(id), bob);
    }

    /// @dev A busy 36-round window: work, blocks, busiest round and entropy are recomputed here
    /// from an independent abi.decode of the captured page and must match what the game logs.
    function testBusyTripHistoryMatchesIndependentDecodeOfLiveBytes() public {
        ISqueekCoreV3.RoundPage memory p = abi.decode(PAGE_194_230, (ISqueekCoreV3.RoundPage));
        assertEq(p.rounds.length, 13);
        uint64 expectedWork = p.end.cumulativeWork - p.start.cumulativeWork;
        uint96 expectedBlocks = p.end.cumulativeBlockUnits / 1e9 - p.start.cumulativeBlockUnits / 1e9;
        uint64 expectedBusiest;
        uint64 previous = p.start.cumulativeWork;
        bytes memory hashes;
        for (uint256 i; i < p.rounds.length; ++i) {
            uint64 delta = p.rounds[i].cumulativeWork - previous;
            if (delta > expectedBusiest) expectedBusiest = delta;
            previous = p.rounds[i].cumulativeWork;
            hashes = bytes.concat(hashes, p.rounds[i].dataHash);
        }
        assertEq(expectedWork, 3811);
        assertEq(expectedBlocks, 366);
        assertEq(expectedBusiest, 500);

        (bool ok, Reader.History memory h) = reader.history(address(core), 194, 230);
        assertTrue(ok);
        assertEq(h.work, expectedWork);
        assertEq(h.blocks, expectedBlocks);
        assertEq(h.busiest, expectedBusiest);
        assertEq(h.entropy, keccak256(hashes));

        _warpToRound(194);
        vm.prank(alice);
        uint256 id = game.hatch();
        vm.prank(alice);
        game.embark(id, 2);
        assertEq(game.expedition(id).startRound, 195);
        assertEq(game.expedition(id).endRound, 230);

        vm.expectEmit(true, true, false, false);
        emit Returned(id, alice, 0, Kind.Trail, Rarity.Common, 0, 0, 0, bytes32(0), 0);
        vm.recordLogs();
        Loot memory result = game.returnHome(id);
        assertEq(uint8(result.kind), uint8(Kind.Trail));
        assertFalse(game.expedition(id).away);

        Vm.Log[] memory logs = vm.getRecordedLogs();
        bool found;
        for (uint256 i; i < logs.length; ++i) {
            if (logs[i].topics[0] != Returned.selector) continue;
            (,,, uint64 loggedWork, uint96 loggedBlocks, uint64 loggedBusiest, bytes32 entropy,) =
                abi.decode(logs[i].data, (uint8, Kind, Rarity, uint64, uint96, uint64, bytes32, uint32));
            assertEq(loggedWork, expectedWork);
            assertEq(loggedBlocks, expectedBlocks);
            assertEq(loggedBusiest, expectedBusiest);
            assertEq(entropy, keccak256(hashes));
            found = true;
        }
        assertTrue(found, "Returned event logged");
    }

    /// @dev Mood reads the last six settled rounds (561..567 at capture) through the same page path.
    function testMoodAndDisplayDataReadTheLiveLayout() public {
        _setPage(
            561,
            561,
            0,
            hex""
        );
        _setPage(
            567,
            567,
            0,
            hex""
        );
        _setPage(
            561,
            567,
            16,
            hex""
        );
        (Mood value, bool signalLost) = game.mood();
        assertFalse(signalLost, "a healthy live core never reports Signal lost");
        assertEq(uint8(value), uint8(Mood.Napping));

        _warpToRound(558);
        vm.prank(alice);
        uint256 id = game.hatch();
        assertFalse(game.displayData(id).signalLost);
        assertEq(uint8(game.displayData(id).mood), uint8(Mood.Napping));
    }
}
